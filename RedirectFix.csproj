<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RedirectFix</RootNamespace>
    <AssemblyName>RedirectFix</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Where the game assemblies come from.

       Set VINTAGE_STORY to a Vintage Story install (or an extracted server
       package) and everything resolves from there, which is what lets this
       build on a clean machine and in CI. Without it the old layout still
       applies: a checkout sitting inside the game source tree, with the install
       at GameInstallDir. Override GameInstallDir on the command line rather than
       editing it, so a local path never ends up in a commit. -->
  <PropertyGroup>
    <GameInstallDir Condition="'$(GameInstallDir)' == ''">A:\VintageStory\</GameInstallDir>
    <VintageStoryDir>$(VINTAGE_STORY)</VintageStoryDir>

    <ApiBinDir Condition="'$(VintageStoryDir)' != ''">$(VintageStoryDir)/</ApiBinDir>
    <GameLibBinDir Condition="'$(VintageStoryDir)' != ''">$(VintageStoryDir)/</GameLibBinDir>
    <HarmonyDir Condition="'$(VintageStoryDir)' != ''">$(VintageStoryDir)/Lib/</HarmonyDir>

    <ApiBinDir Condition="'$(ApiBinDir)' == ''">$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\net10.0\</ApiBinDir>
    <GameLibBinDir Condition="'$(GameLibBinDir)' == ''">$(MSBuildThisFileDirectory)..\..\VintagestoryLib\bin\$(Configuration)\net10.0\</GameLibBinDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">$(GameInstallDir)Lib\</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(ApiBinDir)VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(GameLibBinDir)VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
